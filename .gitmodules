[submodule ".registry"]
	path = .registry
	url = https://github.com/eborgnine/eborgnine.r-universe.dev
	branch = HEAD
[submodule "RCppAD"]
	path = RCppAD
	url = https://github.com/eborgnine/adlaplace
	branch = main
	subdir = RCppAD
[submodule "adlaplace"]
	path = adlaplace
	url = https://github.com/eborgnine/adlaplace
	branch = main
	subdir = adlaplace
[submodule "admvn"]
	path = admvn
	url = https://github.com/eborgnine/adlaplace
	branch = main
	subdir = admvn
